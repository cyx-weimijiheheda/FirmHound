# AI model service (optional; the offline runtime is the default).
#
# The service definition lives in config/models.yaml:
#   runtimes.openai_compatible.base_url / model / timeout / api_key_env
# The key is read from the environment variable named by api_key_env
# (OPENAI_API_KEY by default). Keep the real .env file local (it is gitignored).
#
# OPENAI_API_KEY=your-key-here

# FirmRec native backend (optional; the Docker fallback needs none of these)
# FSA_FIRMREC_REPO_DIR=/path/to/FirmRec
# FSA_FIRMREC_PYTHON_BIN=/path/to/FirmRec/.venv/bin/python
# Optional Ghidra headless for the DECOMPILE stage (same binary as FirmRec's).
# GHIDRA_HEADLESS=/opt/ghidra/support/analyzeHeadless
# FSA_FIRMREC_GHIDRA_HEADLESS=/opt/ghidra/support/analyzeHeadless
# BUSYBOX_BIN=/usr/bin/busybox
# FSA_FIRMREC_PG_PASSWORD=change-me
